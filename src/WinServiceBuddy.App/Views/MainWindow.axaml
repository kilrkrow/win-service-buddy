<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WinServiceBuddy.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="WinServiceBuddy.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="#0F1419"
        Title="Win Service Buddy">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.toolbar">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#1E2A33"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover">
            <Setter Property="Background" Value="#2A3A46"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#00C2A8"/>
            <Setter Property="Foreground" Value="#0B1215"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.linkish">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#5EEAD4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.linkish:disabled">
            <Setter Property="Foreground" Value="#3A4654"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#8B9AAB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#151C23"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#243040"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="Border.help">
            <Setter Property="Background" Value="#1A2430"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#2E4050"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Services grid: full-row highlight only — no per-cell focus box -->
        <Style Selector="DataGrid#ServicesGrid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#1A3A40"/>
        </Style>
        <Style Selector="DataGrid#ServicesGrid DataGridRow:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#1A2830"/>
        </Style>
        <Style Selector="DataGrid#ServicesGrid DataGridRow:selected:pointerover /template/ Rectangle#BackgroundRectangle">
            <Setter Property="Fill" Value="#1F454C"/>
        </Style>
        <Style Selector="DataGrid#ServicesGrid DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <!-- Correct Avalonia template part is Grid#FocusVisual (not a Rectangle) -->
        <Style Selector="DataGrid#ServicesGrid DataGridCell /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGrid#ServicesGrid DataGridCell:current /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGrid#ServicesGrid DataGridCell:focus /template/ Grid#FocusVisual">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
        <Style Selector="DataGrid#ServicesGrid DataGridCell /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="DataGrid#ServicesGrid DataGridCell:current /template/ Rectangle#CurrencyVisual">
            <Setter Property="IsVisible" Value="False"/>
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="DataGrid#ServicesGrid DataGridRow">
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>

        <!-- Dark, slim sidebar scrollbar (default Fluent bar looks wrong on our panels) -->
        <Style Selector="ScrollViewer.sidebar-scroll">
            <Setter Property="AllowAutoHide" Value="False"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        </Style>
        <Style Selector="ScrollViewer.sidebar-scroll ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Margin" Value="2,0,0,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="ScrollViewer.sidebar-scroll ScrollBar Thumb">
            <Setter Property="Background" Value="#3A4A58"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style Selector="ScrollViewer.sidebar-scroll ScrollBar Thumb:pointerover">
            <Setter Property="Background" Value="#5C6B7A"/>
        </Style>
        <Style Selector="ScrollViewer.sidebar-scroll ScrollBar /template/ RepeatButton">
            <Setter Property="IsVisible" Value="False"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Background="#0B1014" Padding="12,8" Margin="0,12,0,0" CornerRadius="6">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Vertical" Spacing="4">
                    <TextBlock Text="{Binding StatusText}" Foreground="#8B9AAB" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <Grid IsVisible="{Binding IsBusy}" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,2,0,0">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding OperationProgress}"
                                     Height="6" MinHeight="6"
                                     Foreground="#00C2A8" Background="#1E2A33"/>
                        <TextBlock Grid.Column="1" Text="{Binding OperationDetail}"
                                   Foreground="#5EEAD4" FontSize="11" VerticalAlignment="Center"
                                   MaxWidth="420" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Background="#2A2010" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsBusy}" Margin="0,0,4,0">
                        <TextBlock Text="Working…" Foreground="#F0C929" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="{Binding HostName}" Foreground="#5C6B7A" VerticalAlignment="Center"/>
                    <Button Classes="toolbar" Content="Run elevated" Command="{Binding RelaunchElevatedCommand}"
                            IsVisible="{Binding !IsElevated}" IsEnabled="{Binding !IsBusy}"/>
                    <Border Background="#123D32" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsElevated}">
                        <TextBlock Text="Elevated" Foreground="#3DDC97" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" IsEnabled="{Binding !IsBusy}">
                    <Button Classes="toolbar accent" Content="Start" Command="{Binding StartSelectedCommand}"/>
                    <Button Classes="toolbar" Content="Stop" Command="{Binding StopSelectedCommand}"/>
                    <Button Classes="toolbar" Content="Restart" Command="{Binding RestartSelectedCommand}"/>
                    <Button Classes="toolbar" Content="Refresh" Command="{Binding RefreshCommand}"/>
                    <Button Classes="toolbar" Content="Select all" Command="{Binding SelectAllCommand}" Margin="16,0,8,0"/>
                    <Button Classes="toolbar" Content="Select none" Command="{Binding SelectNoneCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            IsEnabled="{Binding HasSelection}">
                    <TextBlock Text="Bulk startup" Foreground="#8B9AAB" VerticalAlignment="Center"/>
                    <ComboBox Width="160" SelectedItem="{Binding SelectedStartup}"
                              ItemsSource="{Binding StartupOptions}"
                              IsEnabled="{Binding HasSelection}"/>
                    <Button Classes="toolbar accent" Content="Apply" Command="{Binding ApplyStartupCommand}"/>
                    <TextBlock Text="Recovery" Foreground="#8B9AAB" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox Width="180" SelectedItem="{Binding SelectedRecovery}"
                              ItemsSource="{Binding RecoveryOptions}"
                              IsEnabled="{Binding HasSelection}"/>
                    <Button Classes="toolbar accent" Content="Apply" Command="{Binding ApplyRecoveryCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="300,*">
            <!-- Left: mode pinned; only lower content scrolls (fixes clipped header + ugly bar) -->
            <Border Classes="panel" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock Classes="section" Text="MODE"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,10">
                            <Button Content="Simple" Command="{Binding UseSimpleModeCommand}"
                                    Padding="14,8" CornerRadius="6"
                                    Background="#00C2A8" Foreground="#0B1215"
                                    IsVisible="{Binding IsSimpleMode}"/>
                            <Button Content="Simple" Command="{Binding UseSimpleModeCommand}"
                                    Padding="14,8" CornerRadius="6"
                                    Background="#1E2A33" Foreground="#E6EDF3"
                                    IsVisible="{Binding !IsSimpleMode}"/>
                            <Button Content="Profile" Command="{Binding UseProfileModeCommand}"
                                    Padding="14,8" CornerRadius="6"
                                    Background="#00C2A8" Foreground="#0B1215"
                                    IsVisible="{Binding !IsSimpleMode}"/>
                            <Button Content="Profile" Command="{Binding UseProfileModeCommand}"
                                    Padding="14,8" CornerRadius="6"
                                    Background="#1E2A33" Foreground="#E6EDF3"
                                    IsVisible="{Binding IsSimpleMode}"/>
                        </StackPanel>
                        <Border Classes="help" Margin="0">
                            <TextBlock Text="{Binding ProfileGuidance}" Foreground="#A8B8C8"
                                       TextWrapping="Wrap" FontSize="12" LineHeight="18"/>
                        </Border>
                    </StackPanel>

                    <ScrollViewer Classes="sidebar-scroll" Padding="0,0,2,0">
                        <StackPanel Margin="0,4,4,0">
                            <!-- Simple mode controls -->
                            <StackPanel IsVisible="{Binding ShowSimpleFilter}">
                                <TextBlock Classes="section" Text="SUBSTRING FILTER"/>
                                <TextBox Text="{Binding SubstringFilter}" PlaceholderText="e.g. product token" Margin="0,0,0,8"/>
                                <Button Classes="toolbar accent" Content="Apply filter / refresh"
                                        Command="{Binding RefreshCommand}"
                                        HorizontalAlignment="Stretch"/>
                            </StackPanel>

                            <!-- Profile mode controls -->
                            <StackPanel IsVisible="{Binding ShowProfilePicker}">
                                <Border Classes="help" IsVisible="{Binding ShowNoProfilesHelp}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="No profiles detected"
                                                   FontWeight="SemiBold" Foreground="#F0C929"/>
                                        <TextBlock Text="Browse to a .wsb.json, import samples, or open the Profile Builder."
                                                   TextWrapping="Wrap" Foreground="#A8B8C8" FontSize="12"/>
                                        <Button Classes="toolbar accent" Content="Browse for profile…"
                                                Command="{Binding BrowseProfileCommand}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Classes="toolbar" Content="Use Simple mode"
                                                Command="{Binding UseSimpleModeCommand}"
                                                HorizontalAlignment="Stretch"/>
                                        <Button Classes="toolbar" Content="Import sample profiles…"
                                                Command="{Binding LoadSampleProfilesCommand}"
                                                HorizontalAlignment="Stretch"
                                                ToolTip.Tip="Copies repo sample .wsb.json files into your user profile folder."/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Classes="section" Text="PROFILE"/>
                                <ComboBox ItemsSource="{Binding AvailableProfiles}"
                                          SelectedItem="{Binding SelectedProfileId}"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="Select a profile…"
                                          Margin="0,0,0,8"/>
                                <Button Classes="toolbar" Content="Browse / import…"
                                        Command="{Binding BrowseProfileCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                                <StackPanel IsVisible="{Binding ShowEnvironmentPicker}">
                                    <TextBlock Classes="section" Text="ENVIRONMENT"/>
                                    <ComboBox ItemsSource="{Binding AvailableEnvironments}"
                                              SelectedItem="{Binding SelectedEnvironment}"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Production / Acceptance…"
                                              Margin="0,0,0,8"/>
                                    <TextBlock Text="Environment sets desired startup/recovery (e.g. Production=Automatic, Acceptance=Manual)."
                                               TextWrapping="Wrap" Foreground="#5C6B7A" FontSize="11" Margin="0,0,0,8"/>
                                </StackPanel>

                                <StackPanel IsVisible="{Binding ShowRolePicker}">
                                    <TextBlock Classes="section" Text="ROLE (FROM PROFILE)"/>
                                    <ComboBox ItemsSource="{Binding AvailableRoles}"
                                              SelectedItem="{Binding SelectedRole}"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Select a role…"
                                              Margin="0,0,0,8"/>
                                    <TextBlock Text="Machine function for this product (app host, database host, web tier, …)."
                                               TextWrapping="Wrap" Foreground="#5C6B7A" FontSize="11" Margin="0,0,0,8"/>
                                </StackPanel>

                                <TextBlock Classes="section" Text="PROFILE BUILDER" Margin="0,8,0,8"/>
                                <Button Classes="toolbar accent" Content="Build profile…"
                                        Command="{Binding BuildProfileCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                                <Button Classes="toolbar" Content="Edit profile…"
                                        Command="{Binding EditProfileCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                <Button Classes="toolbar accent" Content="Load / refresh"
                                        Command="{Binding RefreshCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,8,0,0"/>

                                <TextBlock Classes="section" Text="PREREQUISITES" Margin="0,20,0,8"
                                           IsVisible="{Binding HasPrerequisites}"/>
                                <ListBox ItemsSource="{Binding PrerequisiteLines}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="#C5D0DA" FontSize="12"
                                         MaxHeight="180"
                                         IsVisible="{Binding HasPrerequisites}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Center + optional deps panel -->
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <Border Classes="panel" Margin="0,0,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Classes="section" Text="SERVICES"/>
                        <DataGrid x:Name="ServicesGrid"
                                  ItemsSource="{Binding Services}"
                                  SelectedItem="{Binding FocusedService, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserResizeColumns="True"
                                  CanUserSortColumns="True"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  Foreground="#E6EDF3"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <!-- Template CheckBox (not DataGridCheckBoxColumn): single-click works;
                                     DataGridCheckBoxColumn steals the first click for cell focus. -->
                                <DataGridTemplateColumn Header="" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ServiceRowViewModel">
                                            <CheckBox Classes="service-check"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Margin="4,0"
                                                      ToolTip.Tip="Click to select · Shift+click for range"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Display Name" Binding="{Binding Title}" Width="3*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Startup" Binding="{Binding StartupType}" Width="130" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Recovery" Binding="{Binding RecoverySummary}" Width="130" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="Deps" Width="100">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="vm:ServiceRowViewModel">
                                            <Button Classes="linkish"
                                                    Content="{Binding DependenciesButtonLabel}"
                                                    IsEnabled="{Binding HasDependencies}"
                                                    Command="{Binding #Root.((vm:MainViewModel)DataContext).ToggleDependenciesForCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Left"
                                                    ToolTip.Tip="{Binding ServiceName}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- Collapsible dependencies panel -->
                <Border Grid.Column="1" Classes="panel" Margin="12,0,0,0" Width="300"
                        IsVisible="{Binding IsDependenciesPanelOpen}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                            <TextBlock Classes="section" Text="{Binding DependenciesHeader}"
                                       TextWrapping="Wrap" Margin="0" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Classes="linkish" Content="✕"
                                    FontSize="16" FontWeight="Bold"
                                    Command="{Binding CloseDependenciesPanelCommand}"
                                    VerticalAlignment="Top"
                                    ToolTip.Tip="Close dependencies panel"
                                    Padding="10,4"/>
                        </Grid>

                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Spacing="2"
                                    IsVisible="{Binding !ShowDependenciesEmptyMessage}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock FontSize="10"><Run Foreground="#3DDC97" Text="● Running"/></TextBlock>
                                <TextBlock FontSize="10"><Run Foreground="#FF6B6B" Text="● Stopped"/></TextBlock>
                                <TextBlock FontSize="10"><Run Foreground="#8B9AAB" Text="⊘ Disabled"/></TextBlock>
                                <TextBlock FontSize="10"><Run Foreground="#F0C929" Text="! Missing"/></TextBlock>
                            </StackPanel>
                            <TextBlock Text="Click a dependency to select it in the table"
                                       Foreground="#5C6B7A" FontSize="10"/>
                        </StackPanel>

                        <TextBlock Text="{Binding DependenciesEmptyMessage}"
                                   IsVisible="{Binding ShowDependenciesEmptyMessage}"
                                   Foreground="#8B9AAB"
                                   TextWrapping="Wrap"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   Margin="12"/>

                        <ListBox ItemsSource="{Binding DependencyItems}"
                                 IsVisible="{Binding !ShowDependenciesEmptyMessage}"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#C5D0DA">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:DependencyItemViewModel">
                                    <Button Background="Transparent" BorderThickness="0"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left"
                                            Padding="4,8"
                                            Cursor="Hand"
                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).NavigateToDependencyCommand}"
                                            CommandParameter="{Binding}"
                                            ToolTip.Tip="{Binding ToolTip}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <TextBlock Text="{Binding StatusIcon}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontSize="14"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Title}"
                                                       TextWrapping="Wrap"
                                                       Foreground="#E6EDF3"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding StatusLabel}"
                                                       Foreground="{Binding StatusBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Margin="8,0,0,0"/>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
