<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WinServiceBuddy.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="WinServiceBuddy.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="#0F1419"
        Title="Win Service Buddy">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.toolbar">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#1E2A33"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.toolbar:pointerover">
            <Setter Property="Background" Value="#2A3A46"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#00C2A8"/>
            <Setter Property="Foreground" Value="#0B1215"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="Foreground" Value="#8B9AAB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#151C23"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#243040"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    <DockPanel Margin="12">
        <Border DockPanel.Dock="Bottom" Background="#0B1014" Padding="12,8" Margin="0,12,0,0" CornerRadius="6">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding StatusText}" Foreground="#8B9AAB" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding HostName}" Foreground="#5C6B7A" VerticalAlignment="Center"/>
                    <Button Classes="toolbar" Content="Run elevated" Command="{Binding RelaunchElevatedCommand}"
                            IsVisible="{Binding !IsElevated}"/>
                    <Border Background="#123D32" CornerRadius="4" Padding="8,4" IsVisible="{Binding IsElevated}">
                        <TextBlock Text="Elevated" Foreground="#3DDC97" FontSize="12"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal">
                    <Button Classes="toolbar accent" Content="Start" Command="{Binding StartSelectedCommand}"/>
                    <Button Classes="toolbar" Content="Stop" Command="{Binding StopSelectedCommand}"/>
                    <Button Classes="toolbar" Content="Restart" Command="{Binding RestartSelectedCommand}"/>
                    <Button Classes="toolbar" Content="Refresh" Command="{Binding RefreshCommand}"/>
                    <Button Classes="toolbar" Content="Select all" Command="{Binding SelectAllCommand}" Margin="16,0,8,0"/>
                    <Button Classes="toolbar" Content="Select none" Command="{Binding SelectNoneCommand}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="Bulk startup" Foreground="#8B9AAB" VerticalAlignment="Center"/>
                    <ComboBox Width="160" SelectedItem="{Binding SelectedStartup}"
                              ItemsSource="{Binding StartupOptions}"/>
                    <Button Classes="toolbar accent" Content="Apply" Command="{Binding ApplyStartupCommand}"/>
                    <TextBlock Text="Recovery" Foreground="#8B9AAB" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <ComboBox Width="180" SelectedItem="{Binding SelectedRecovery}"
                              ItemsSource="{Binding RecoveryOptions}"/>
                    <Button Classes="toolbar accent" Content="Apply" Command="{Binding ApplyRecoveryCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="260,*,280">
            <Border Classes="panel" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Classes="section" Text="SCOPE"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,16">
                        <Button Content="Simple" Command="{Binding UseSimpleModeCommand}"
                                Padding="14,8" CornerRadius="6"
                                Background="#00C2A8" Foreground="#0B1215"/>
                        <Button Content="Profile" Command="{Binding UseProfileModeCommand}"
                                Padding="14,8" CornerRadius="6"
                                Background="#1E2A33" Foreground="#E6EDF3"/>
                    </StackPanel>

                    <TextBlock Classes="section" Text="SUBSTRING FILTER"/>
                    <TextBox Text="{Binding SubstringFilter}" PlaceholderText="e.g. Milestone" Margin="0,0,0,8"/>
                    <Button Classes="toolbar accent" Content="Apply filter / refresh" Command="{Binding RefreshCommand}"
                            HorizontalAlignment="Stretch" Margin="0,0,0,16"/>

                    <TextBlock Classes="section" Text="PROFILE"/>
                    <ComboBox ItemsSource="{Binding AvailableProfiles}"
                              SelectedItem="{Binding SelectedProfileId}"
                              HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                    <TextBlock Classes="section" Text="ROLE"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="Server" Command="{Binding SetRoleServerCommand}" Padding="12,6" CornerRadius="6"
                                Background="#1E2A33" Foreground="#E6EDF3"/>
                        <Button Content="Client" Command="{Binding SetRoleClientCommand}" Padding="12,6" CornerRadius="6"
                                Background="#1E2A33" Foreground="#E6EDF3"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ModeLabel, StringFormat=Mode: {0}}" Foreground="#5C6B7A" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding SelectedRole, StringFormat=Role: {0}}" Foreground="#5C6B7A" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="panel" Margin="0,0,12,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="SERVICES"/>
                    <DataGrid ItemsSource="{Binding Services}"
                              AutoGenerateColumns="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0"
                              Background="Transparent"
                              Foreground="#E6EDF3">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="" Binding="{Binding IsSelected, Mode=TwoWay}" Width="40"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Service Name" Binding="{Binding ServiceName}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Display Name" Binding="{Binding DisplayName}" Width="2*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Startup" Binding="{Binding StartupType}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Recovery" Binding="{Binding RecoverySummary}" Width="140" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Classes="panel">
                <Grid RowDefinitions="*,*">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Top" Classes="section" Text="DEPENDENCIES"/>
                        <ListBox ItemsSource="{Binding DependencyLines}" Background="Transparent" BorderThickness="0"
                                 Foreground="#C5D0DA" FontSize="12"/>
                    </DockPanel>
                    <DockPanel Grid.Row="1">
                        <TextBlock DockPanel.Dock="Top" Classes="section" Text="PREREQUISITES"/>
                        <ListBox ItemsSource="{Binding PrerequisiteLines}" Background="Transparent" BorderThickness="0"
                                 Foreground="#C5D0DA" FontSize="12"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
