{
  "schemaVersion": 2,
  "id": "multi-tier-abstract-sample",
  "name": "Multi-tier product (abstract sample)",
  "description": "Illustrates product + environments (Production vs Acceptance), ordered services, and role-scoped prerequisites. Not vendor-specific.",
  "productVersionNote": "Sample for schema/UX — not a real product definition.",
  "defaultRoles": [ "Application Server" ],
  "roles": [
    "Application Server",
    "Database Host",
    "Web Front End",
    "Client Workstation"
  ],
  "defaultEnvironment": "Production",
  "environments": [
    {
      "id": "production",
      "name": "Production",
      "defaultStartup": "Automatic",
      "defaultRecovery": "restart-3"
    },
    {
      "id": "acceptance",
      "name": "Acceptance",
      "defaultStartup": "Manual",
      "defaultRecovery": "none"
    }
  ],
  "includeScmDependencies": true,
  "dependencyDirection": "dependsOn",
  "services": [
    {
      "serviceName": "Example.AppCore",
      "displayNameHint": "App Core",
      "order": 10,
      "roles": [ "Application Server" ],
      "optional": false
    },
    {
      "serviceName": "Example.AppWorker",
      "displayNameHint": "App Worker",
      "order": 20,
      "roles": [ "Application Server" ],
      "optional": false
    },
    {
      "serviceName": "MSSQLSERVER",
      "displayNameHint": "SQL Server",
      "order": 5,
      "roles": [ "Database Host" ],
      "optional": false
    },
    {
      "serviceName": "W3SVC",
      "displayNameHint": "IIS WWW",
      "order": 30,
      "roles": [ "Web Front End", "Application Server" ],
      "optional": true
    }
  ],
  "matchRules": [],
  "prerequisites": [
    {
      "id": "sql-engine",
      "title": "SQL Server engine (when this host is Database Host)",
      "roles": [ "Database Host" ],
      "checks": [
        { "type": "serviceExists", "serviceName": "MSSQLSERVER", "severity": "error" }
      ],
      "docRef": "Product docs: database tier requires a SQL Server instance (local or dedicated host)."
    },
    {
      "id": "msmq",
      "title": "Message Queuing (when required by this role)",
      "roles": [ "Application Server", "Client Workstation" ],
      "checks": [
        { "type": "serviceExists", "serviceName": "MSMQ", "severity": "error" }
      ],
      "docRef": "Product docs: some roles require Microsoft Message Queuing."
    },
    {
      "id": "iis",
      "title": "IIS World Wide Web Publishing",
      "roles": [ "Web Front End" ],
      "checks": [
        { "type": "serviceExists", "serviceName": "W3SVC", "severity": "error" }
      ],
      "docRef": "Product docs: web tier requires IIS (W3SVC)."
    }
  ],
  "metadata": {
    "author": "Win Service Buddy samples"
  }
}
